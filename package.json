{
  "name": "iron-raptor-digital",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --configuration production --base-href / && node scripts/gh-pages-postbuild.mjs",
    "build:gh-pages:preview": "ng build --configuration production --base-href /iron-raptor-digital/ && node scripts/gh-pages-postbuild.mjs --preview",
    "deploy": "npm run build:gh-pages && npx angular-cli-ghpages --dir=dist/iron-raptor-digital/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^25.0.9",
    "autoprefixer": "^10.4.23",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
